{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@Dento/api": "*",
		"@Dento/auth": "*",
		"@Dento/db": "*",
		"@Dento/env": "*",
		"@hono/node-server": "^2.0.8",
		"@orpc/openapi": "^1.14.6",
		"@orpc/server": "^1.14.6",
		"@orpc/zod": "^1.14.6",
		"better-auth": "1.6.23",
		"dotenv": "^17.4.2",
		"evlog": "^2.22.0",
		"hono": "^4.12.27",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@Dento/config": "*",
		"@types/node": "^22.13.14",
		"tsdown": "^0.22.3",
		"tsx": "^4.22.5",
		"typescript": "^6"
	}
}
